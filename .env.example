# Demo mode is the safe default. Provider keys are required only after the
# operator deliberately switches APP_RUNTIME_MODE to cloud in the local .env.
APP_RUNTIME_MODE=demo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Stage B is opt-in; keep false until local verification tests and a pilot pass.
STAGE_B_VERIFICATION_ENABLED=false
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_FREE_ONLY=true
# Free-model status was checked 2026-08-22; recheck official pricing before release.
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
RETRIEVAL_LIMIT=20
RERANK_LIMIT=6
RELEVANCE_THRESHOLD=0.35
INGESTION_MAX_FILE_BYTES=8388608
INGESTION_MAX_PDF_PAGES=200
INGESTION_MAX_PDF_PIXELS=20000000
INGESTION_MAX_PDF_RENDER_BYTES=4194304
INGESTION_MAX_DOCX_PARAGRAPHS=10000
INGESTION_MAX_DOCX_UNCOMPRESSED_BYTES=33554432
INGESTION_MAX_DOCX_ZIP_ENTRIES=2000
INGESTION_MAX_TEXT_CHARS=500000
INGESTION_FILE_TIMEOUT_SECONDS=30
INGESTION_SCAN_MAX_FILES=100
DEEPSEEK_STREAM_MAX_BYTES=1048576
DEEPSEEK_STREAM_MAX_CHARS=200000
DEEPSEEK_STREAM_MAX_EVENTS=2048
DEEPSEEK_STREAM_TIMEOUT_SECONDS=60
SOURCE_DOCUMENTS_DIR=../demo/documents
DEMO_QUESTIONS_PATH=../demo/questions.json
PRIVATE_DATA_DIR=../data/runtime/demo/private
QDRANT_PATH=../data/runtime/demo/qdrant
SQLITE_PATH=../data/runtime/demo/app.sqlite3
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
